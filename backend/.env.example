# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── JWT Authentication (replaces Azure AD B2C) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ── Azure Cosmos DB (NoSQL) ───────────────────────────────────────────────────
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=PixoGram

# ── Azure Blob Storage ────────────────────────────────────────────────────────
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=photos
STORAGE_THUMBNAIL_CONTAINER=thumbnails

# ── Azure Computer Vision ─────────────────────────────────────────────────────
VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
VISION_KEY=your-vision-api-key

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_HOST=your-redis-hostname.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,https://yourdomain.com

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=20971520
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=PixoGram
APP_VERSION=1.0.0
LOG_LEVEL=debug
